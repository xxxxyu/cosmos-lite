diff --git a/robolab/tools/validate_droid_trajectory.py b/robolab/tools/validate_droid_trajectory.py
new file mode 100644
index 0000000..0532b29
--- /dev/null
+++ b/robolab/tools/validate_droid_trajectory.py
@@ -0,0 +1,166 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Validate a training-ready Cosmos-DROID LeRobot v3 trajectory dataset."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import av
+import h5py
+import numpy as np
+import pandas as pd
+
+from robolab.core.logging.droid_lerobot_trajectory import (
+    FPS,
+    IMAGE_FEATURES,
+    IMAGE_HEIGHT,
+    IMAGE_WIDTH,
+    droid_features,
+)
+
+
+def _read_parquet_tree(root: Path) -> pd.DataFrame:
+    files = sorted(root.glob("chunk-*/*.parquet"))
+    if not files:
+        raise ValueError(f"No Parquet files found under {root}")
+    return pd.concat([pd.read_parquet(path) for path in files], ignore_index=True)
+
+
+def _require(condition: bool, message: str) -> None:
+    if not condition:
+        raise ValueError(message)
+
+
+def _video_path(success_root: Path, episode: pd.Series, key: str) -> Path:
+    chunk = int(episode[f"videos/{key}/chunk_index"])
+    file_index = int(episode[f"videos/{key}/file_index"])
+    return success_root / "videos" / key / f"chunk-{chunk:03d}" / f"file-{file_index:03d}.mp4"
+
+
+def validate_dataset(path: str | Path, *, check_cosmos_loader: bool = False) -> dict[str, int]:
+    root = Path(path).resolve()
+    success_root = root if root.name == "success" else root / "success"
+    dataset_root = success_root.parent
+    _require(success_root.is_dir(), f"Missing LeRobot success dataset: {success_root}")
+
+    info = json.loads((success_root / "meta" / "info.json").read_text())
+    _require(info["codebase_version"].startswith("v3"), "Dataset is not LeRobot v3")
+    _require(info["fps"] == FPS, f"Expected {FPS} FPS, got {info['fps']}")
+    expected_features = droid_features()
+    for key, expected in expected_features.items():
+        feature = info["features"].get(key)
+        _require(feature is not None, f"Missing feature: {key}")
+        _require(tuple(feature["shape"]) == tuple(expected["shape"]), f"Wrong shape for {key}")
+        if expected["dtype"] == "video":
+            video = feature.get("info", {})
+            _require(
+                (video.get("video.width"), video.get("video.height"), video.get("video.fps"))
+                == (IMAGE_WIDTH, IMAGE_HEIGHT, FPS),
+                f"Wrong video metadata for {key}",
+            )
+
+    data = _read_parquet_tree(success_root / "data")
+    episodes = _read_parquet_tree(success_root / "meta" / "episodes")
+    _require(len(data) == int(info["total_frames"]), "Frame count disagrees with info.json")
+    _require(len(episodes) == int(info["total_episodes"]), "Episode count disagrees with info.json")
+    ordered = data.sort_values("index")
+    np.testing.assert_array_equal(ordered["index"].to_numpy(), np.arange(len(data)))
+
+    for _, episode in episodes.sort_values("episode_index").iterrows():
+        episode_index = int(episode["episode_index"])
+        length = int(episode["length"])
+        rows = data[data["episode_index"] == episode_index].sort_values("frame_index")
+        _require(len(rows) == length, f"Episode {episode_index}: Parquet length mismatch")
+        np.testing.assert_array_equal(rows["frame_index"].to_numpy(), np.arange(length))
+        np.testing.assert_allclose(rows["timestamp"].to_numpy(), np.arange(length) / FPS, atol=1e-6)
+        _require(bool(episode["success"]), f"Episode {episode_index}: failure entered success dataset")
+        _require(episode["termination_reason"] == "success", f"Episode {episode_index}: invalid termination reason")
+
+        for key in IMAGE_FEATURES:
+            video_path = _video_path(success_root, episode, key)
+            _require(video_path.is_file(), f"Episode {episode_index}: missing {video_path}")
+            with av.open(str(video_path)) as container:
+                frames = sum(1 for _ in container.decode(video=0))
+            _require(frames == length, f"Episode {episode_index}: {key} has {frames}/{length} frames")
+
+        sidecar_path = dataset_root / episode["sidecar_path"]
+        sidecar = json.loads(sidecar_path.read_text())
+        for key in (
+            "task",
+            "language_instruction",
+            "seed",
+            "checkpoint",
+            "episode_length",
+            "termination_reason",
+            "initial_state",
+            "camera_extrinsics",
+            "env_config",
+            "rollout_timing",
+            "recording_timing",
+        ):
+            _require(key in sidecar, f"Episode {episode_index}: sidecar missing {key}")
+        _require(sidecar["checkpoint"] not in {"", "unknown", "replace-with-model-id-or-checkpoint-digest"},
+                 f"Episode {episode_index}: checkpoint provenance is unset")
+        _require(set(IMAGE_FEATURES.values()) <= set(sidecar["camera_extrinsics"]),
+                 f"Episode {episode_index}: camera extrinsics are incomplete")
+
+        hdf5_path = dataset_root / sidecar["trajectory_sidecar"]
+        with h5py.File(hdf5_path) as handle:
+            demo = handle["data/demo_0"]
+            for key in ("actions", "initial_state", "states/rigid_object", "bbox/bbox_mm"):
+                _require(key in demo, f"Episode {episode_index}: HDF5 sidecar missing {key}")
+            actions = demo["actions"][:]
+            _require(actions.shape == (length, 8), f"Episode {episode_index}: HDF5 action shape mismatch")
+            np.testing.assert_array_equal(np.stack(rows["action.joint_position"]), actions[:, :7])
+            expected_gripper = 1.0 - (actions[:, 7] > 0.5).astype(np.float32)
+            np.testing.assert_array_equal(np.asarray(rows["action.gripper_position"]), expected_gripper)
+
+    from lerobot.datasets.lerobot_dataset import LeRobotDataset
+
+    dataset = LeRobotDataset(repo_id="local/validation", root=success_root)
+    _require(dataset.num_episodes == len(episodes), "LeRobot loader episode count mismatch")
+    _require(dataset.num_frames == len(data), "LeRobot loader frame count mismatch")
+
+    if check_cosmos_loader:
+        from cosmos_framework.data.generator.action.datasets.droid_lerobot_dataset import DROIDLeRobotDataset
+
+        cosmos_dataset = DROIDLeRobotDataset(
+            root=str(dataset_root),
+            split="train",
+            split_val_ratio=0.0,
+            action_space="joint_pos",
+            use_state=True,
+            use_success_only=True,
+            viewpoint="concat_view",
+            chunk_length=1,
+        )
+        _require(len(cosmos_dataset) > 0, "Cosmos loader produced no training samples")
+        sample = cosmos_dataset[0]
+        _require(tuple(sample["action"].shape[-1:]) == (8,), "Cosmos loader action shape mismatch")
+
+    return {"episodes": len(episodes), "frames": len(data), "videos": len(episodes) * len(IMAGE_FEATURES)}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("dataset", help="Trajectory root or its success/ subdirectory")
+    parser.add_argument(
+        "--check-cosmos-loader",
+        action="store_true",
+        help="Also instantiate Cosmos' DROID joint-position training loader (run from a Cosmos environment).",
+    )
+    args = parser.parse_args()
+    result = validate_dataset(args.dataset, check_cosmos_loader=args.check_cosmos_loader)
+    print(
+        "VALID: "
+        f"{result['episodes']} successful episodes, {result['frames']} aligned frames, "
+        f"{result['videos']} H.264 videos"
+    )
+
+
+if __name__ == "__main__":
+    main()
