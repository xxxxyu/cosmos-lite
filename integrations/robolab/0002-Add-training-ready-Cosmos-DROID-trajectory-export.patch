+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+import numpy as np
+import pandas as pd
+import pytest
+import torch
+
+from robolab.core.logging.droid_lerobot_trajectory import (
+    IMAGE_FEATURES,
+    DroidLeRobotTrajectoryRecorder,
+    DroidTrajectoryConfig,
+    _official_droid_gripper,
+    _resize_rgb_batch,
+    _resize_rgb_streams,
+    build_droid_frame,
+    droid_features,
+)
+from robolab.core.logging.lerobot_trajectory import (
+    LeRobotVideoEpisode,
+    VideoEncodingConfig,
+    VideoStreamConfig,
+    resize_rgb_streams,
+    video_features,
+)
+
+
+def test_generic_video_streams_support_custom_mapping_resolution_and_fps():
+    streams = (
+        VideoStreamConfig("observation.images.front", "front_cam", 320, 180),
+        VideoStreamConfig("observation.images.wrist", "hand_cam", 160, 120),
+    )
+    features = video_features(streams)
+    assert features["observation.images.front"]["shape"] == (180, 320, 3)
+    assert features["observation.images.wrist"]["shape"] == (120, 160, 3)
+    VideoEncodingConfig(fps=30, codec="libx264", queue_frames=2).validate()
+
+    observations = {
+        "front_cam": torch.full((2, 360, 640, 3), 31, dtype=torch.uint8),
+        "hand_cam": torch.full((2, 240, 320, 3), 47, dtype=torch.uint8),
+    }
+    resized = resize_rgb_streams(observations, [1], streams)
