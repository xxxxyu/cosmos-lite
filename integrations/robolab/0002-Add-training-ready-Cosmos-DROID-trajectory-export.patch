+class AsyncVideoWriter:
+    """Bounded background wrapper for a streaming :class:`VideoWriter`."""
+
+    _STOP = object()
+
+    def __init__(
+        self,
+        video_path: str,
+        fps: int,
+        *,
+        queue_frames: int = 4,
+        frame_callback: Callable[[np.ndarray], None] | None = None,
+        **writer_kwargs,
+    ):
+        if queue_frames < 1:
+            raise ValueError("queue_frames must be positive")
+        self.video_path = video_path
+        self._writer = VideoWriter(video_path, fps, **writer_kwargs)
+        self._frame_callback = frame_callback
+        self._queue = queue.Queue(maxsize=queue_frames)
+        self._done = threading.Event()
+        self._error: BaseException | None = None
+        self._released = False
+        self._thread = threading.Thread(
+            target=self._run,
+            name=f"video-writer-{id(self):x}",
+            daemon=True,
+        )
+        self._thread.start()
+        atexit.register(self.release)
+        self._atexit_registered = True
+
+    def _run(self) -> None:
+        try:
+            while True:
+                frame = self._queue.get()
+                if frame is self._STOP:
+                    return
+                self._writer.write(frame)
+                if self._frame_callback is not None:
+                    self._frame_callback(frame)
+        except BaseException as exc:
+            self._error = exc
+        finally:
+            self._writer.release()
+            self._done.set()
+
+    def _raise_worker_error(self) -> None:
+        if self._error is not None:
+            raise RuntimeError(f"Background video encoding failed for {self.video_path}") from self._error
+
+    def write(self, frame: np.ndarray) -> None:
+        if self._released:
+            raise RuntimeError(f"Cannot write to released video writer: {self.video_path}")
+        while not self._done.is_set():
+            try:
+                self._queue.put(frame, timeout=0.1)
+                return
+            except queue.Full:
+                continue
+        self._raise_worker_error()
+        raise RuntimeError(f"Background video writer stopped unexpectedly: {self.video_path}")
+
+    def release(self) -> None:
+        if self._released:
+            return
+        self._released = True
+        while not self._done.is_set():
+            try:
+                self._queue.put(self._STOP, timeout=0.1)
+                break
+            except queue.Full:
+                continue
+        self._thread.join()
+        if self._atexit_registered:
+            atexit.unregister(self.release)
+            self._atexit_registered = False
+        self._raise_worker_error()
+
+    def __del__(self):
+        try:
+            self.release()
+        except Exception:
+            logger.exception("Failed to release async video writer for '%s'", self.video_path)
