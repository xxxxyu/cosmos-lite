+def test_async_video_writer_applies_bounded_backpressure(monkeypatch, tmp_path):
+    encoder_started = threading.Event()
+    allow_encoder = threading.Event()
+
+    class BlockingWriter:
+        def __init__(self, *_args, **_kwargs):
+            pass
+
+        def write(self, _frame):
+            encoder_started.set()
+            assert allow_encoder.wait(timeout=5)
+
+        def release(self):
+            pass
+
+    monkeypatch.setattr(video_utils, "VideoWriter", BlockingWriter)
+    writer = video_utils.AsyncVideoWriter(str(tmp_path / "bounded.mp4"), 15, queue_frames=1)
+    frame = np.zeros((2, 2, 3), dtype=np.uint8)
+    writer.write(frame)
+    assert encoder_started.wait(timeout=1)
+    writer.write(frame)
+
+    third_write_done = threading.Event()
+    producer = threading.Thread(target=lambda: (writer.write(frame), third_write_done.set()))
+    producer.start()
+    time.sleep(0.15)
+    assert not third_write_done.is_set()
+
+    allow_encoder.set()
+    producer.join(timeout=2)
+    assert third_write_done.is_set()
+    writer.release()
+
+
+def test_async_video_writer_propagates_worker_failure(monkeypatch, tmp_path):
+    class FailingWriter:
+        def __init__(self, *_args, **_kwargs):
+            pass
+
+        def write(self, _frame):
+            raise OSError("encoder failed")
+
+        def release(self):
+            pass
+
+    monkeypatch.setattr(video_utils, "VideoWriter", FailingWriter)
+    writer = video_utils.AsyncVideoWriter(str(tmp_path / "failed.mp4"), 15, queue_frames=1)
+    writer.write(np.zeros((2, 2, 3), dtype=np.uint8))
+    assert writer._done.wait(timeout=1)
+    with pytest.raises(RuntimeError, match="Background video encoding failed"):
+        writer.release()
