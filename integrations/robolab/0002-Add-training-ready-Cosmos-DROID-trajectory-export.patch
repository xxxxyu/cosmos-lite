+# SPDX-License-Identifier: Apache-2.0
+
+"""Reusable streaming video support for LeRobot trajectory recorders."""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+
+@dataclass(frozen=True)
+class VideoStreamConfig:
+    """Map one simulator RGB observation to one LeRobot video feature."""
+
+    feature_key: str
+    observation_key: str
+    width: int
+    height: int
+
+    def validate(self) -> None:
+        if not self.feature_key or not self.observation_key:
+            raise ValueError("Video stream keys must be non-empty")
+        if self.width < 2 or self.height < 2:
+            raise ValueError("Video stream width and height must be at least 2")
+
+
+@dataclass(frozen=True)
+class VideoEncodingConfig:
+    """Encoding controls shared by all streams in a trajectory recorder."""
+
+    fps: int
+    codec: str = "h264"
+    pixel_format: str = "yuv420p"
+    crf: int = 23
+    preset: str = "ultrafast"
+    threads_per_stream: int = 1
+    queue_frames: int = 4
+    ffmpeg_params: tuple[str, ...] = ()
+    image_stats_pixel_stride: int = 4
+    image_stats_frame_stride: int = 1
+
+    def validate(self) -> None:
+        if self.fps < 1:
+            raise ValueError("fps must be positive")
+        if self.queue_frames < 1:
+            raise ValueError("queue_frames must be positive")
+        if self.threads_per_stream < 1:
+            raise ValueError("threads_per_stream must be positive")
+        if self.image_stats_pixel_stride < 1:
+            raise ValueError("image_stats_pixel_stride must be positive")
+        if self.image_stats_frame_stride < 1:
+            raise ValueError("image_stats_frame_stride must be positive")
+
+
+def video_features(streams: tuple[VideoStreamConfig, ...]) -> dict[str, dict[str, Any]]:
+    """Build LeRobot feature entries for configurable RGB video streams."""
+    result = {}
+    for stream in streams:
+        stream.validate()
+        if stream.feature_key in result:
+            raise ValueError(f"Duplicate video feature: {stream.feature_key}")
+        result[stream.feature_key] = {
+            "dtype": "video",
+            "shape": (stream.height, stream.width, 3),
+            "names": ["height", "width", "channels"],
+        }
+    return result
+
+
+def resize_rgb_batch(
+    images: torch.Tensor,
+    env_ids: list[int],
+    *,
+    width: int,
+    height: int,
+) -> np.ndarray:
+    """Resize an NHWC uint8 batch before one contiguous CPU transfer."""
+    selected = images[env_ids].detach().permute(0, 3, 1, 2)
+    if selected.shape[-2:] != (height, width):
+        selected = F.interpolate(
+            selected.to(torch.float16 if selected.is_cuda else torch.float32),
+            size=(height, width),
+            mode="bilinear",
+            align_corners=False,
+            antialias=True,
+        ).round_().clamp_(0, 255).to(torch.uint8)
+    return selected.permute(0, 2, 3, 1).contiguous().cpu().numpy()
+
+
+def resize_rgb_streams(
+    image_obs: dict[str, torch.Tensor],
+    env_ids: list[int],
+    streams: tuple[VideoStreamConfig, ...],
+) -> dict[str, np.ndarray]:
+    """Resize stream groups with compatible shapes in batched GPU operations."""
+    if not streams:
+        return {}
+    groups: dict[tuple[Any, ...], list[VideoStreamConfig]] = {}
+    for stream in streams:
+        stream.validate()
+        images = image_obs[stream.observation_key]
+        if images.ndim != 4 or images.shape[-1] != 3:
+            raise ValueError(
+                f"Expected NHWC RGB observation for {stream.observation_key}, got {tuple(images.shape)}"
+            )
+        group_key = (
+            stream.height,
+            stream.width,
+            tuple(images.shape[1:]),
+            images.device,
+            images.dtype,
+        )
+        groups.setdefault(group_key, []).append(stream)
+
+    result = {}
+    for group in groups.values():
+        first = group[0]
+        selected = torch.stack(
+            [image_obs[stream.observation_key][env_ids] for stream in group]
+        )
+        stream_count, env_count, _, _, channels = selected.shape
+        selected = selected.permute(0, 1, 4, 2, 3).flatten(0, 1)
+        if selected.shape[-2:] != (first.height, first.width):
+            selected = F.interpolate(
+                selected.to(torch.float16 if selected.is_cuda else torch.float32),
+                size=(first.height, first.width),
+                mode="bilinear",
+                align_corners=False,
+                antialias=True,
+            ).round_().clamp_(0, 255).to(torch.uint8)
+        host = (
+            selected.reshape(stream_count, env_count, channels, first.height, first.width)
+            .permute(0, 1, 3, 4, 2)
+            .contiguous()
+            .cpu()
+            .numpy()
+        )
+        result.update({stream.feature_key: host[index] for index, stream in enumerate(group)})
+    return result
+
+
+class _ImageStats:
+    """Constant-memory RGB statistics compatible with LeRobot metadata."""
+
+    def __init__(self, pixel_stride: int, frame_stride: int) -> None:
+        self.pixel_stride = pixel_stride
+        self.frame_stride = frame_stride
+        self.frames_seen = 0
+        self.frames = 0
+        self.pixels = 0
+        self.sum = np.zeros(3, dtype=np.float64)
+        self.sum_squares = np.zeros(3, dtype=np.float64)
+        self.minimum = np.full(3, 255, dtype=np.uint8)
+        self.maximum = np.zeros(3, dtype=np.uint8)
+        self.histogram = np.zeros((3, 256), dtype=np.int64)
+
+    def update(self, image: np.ndarray) -> None:
+        frame_index = self.frames_seen
+        self.frames_seen += 1
+        if frame_index % self.frame_stride:
+            return
+        pixels = np.asarray(image, dtype=np.uint8)[:: self.pixel_stride, :: self.pixel_stride].reshape(-1, 3)
+        self.frames += 1
+        self.pixels += len(pixels)
+        self.sum += pixels.sum(axis=0, dtype=np.float64)
+        self.sum_squares += np.square(pixels, dtype=np.float64).sum(axis=0)
+        self.minimum = np.minimum(self.minimum, pixels.min(axis=0))
+        self.maximum = np.maximum(self.maximum, pixels.max(axis=0))
+        for channel in range(3):
+            self.histogram[channel] += np.bincount(pixels[:, channel], minlength=256)
+
+    def result(self) -> dict[str, np.ndarray]:
+        if not self.frames:
+            raise RuntimeError("Cannot compute image statistics without frames")
+        mean = self.sum / self.pixels
+        variance = np.maximum(0.0, self.sum_squares / self.pixels - mean**2)
+        cumulative = self.histogram.cumsum(axis=1)
+        quantiles = {}
+        for value in (0.01, 0.10, 0.50, 0.90, 0.99):
+            target = max(1, int(np.ceil(value * self.pixels)))
+            quantiles[f"q{int(value * 100):02d}"] = np.array(
+                [np.searchsorted(cumulative[channel], target) for channel in range(3)],
+                dtype=np.float64,
+            )
+
+        def normalized(value: np.ndarray) -> np.ndarray:
+            return (value.astype(np.float64) / 255.0).reshape(3, 1, 1)
+
+        return {
+            "min": normalized(self.minimum),
+            "max": normalized(self.maximum),
+            "mean": normalized(mean),
+            "std": normalized(np.sqrt(variance)),
+            "count": np.array([self.frames]),
+            **{key: normalized(value) for key, value in quantiles.items()},
+        }
+
+
+@dataclass
+class LeRobotVideoEpisode:
+    """Stream one episode's video features into a LeRobot dataset buffer."""
+
+    dataset: Any
+    source_root: Path
+    streams: tuple[VideoStreamConfig, ...]
+    encoding: VideoEncodingConfig
+    paths: dict[str, Path] = field(default_factory=dict)
+    writers: dict[str, Any] = field(default_factory=dict)
+    image_stats: dict[str, _ImageStats] = field(default_factory=dict)
+
+    def start(self) -> None:
+        from robolab.core.utils.video_utils import AsyncVideoWriter
+
+        if self.writers:
+            raise RuntimeError("Episode video streams are already active")
+        self.encoding.validate()
+        expected = video_features(self.streams)
+        for feature_key, feature in expected.items():
+            if self.dataset.features.get(feature_key) != feature:
+                raise ValueError(f"LeRobot feature does not match stream config: {feature_key}")
+            episode_index = self.dataset.meta.total_episodes
+            temp_dir = Path(tempfile.mkdtemp(prefix="stream-", dir=self.source_root))
+            path = temp_dir / f"{feature_key}_{episode_index:06d}.mp4"
+            self.paths[feature_key] = path
+            stats = _ImageStats(
+                self.encoding.image_stats_pixel_stride,
+                self.encoding.image_stats_frame_stride,
+            )
+            self.image_stats[feature_key] = stats
+            self.writers[feature_key] = AsyncVideoWriter(
+                str(path),
+                self.encoding.fps,
+                queue_frames=self.encoding.queue_frames,
+                codec="libx264" if self.encoding.codec == "h264" else self.encoding.codec,
+                pixel_format=self.encoding.pixel_format,
+                preset=self.encoding.preset,
+                crf=self.encoding.crf,
+                threads=self.encoding.threads_per_stream,
+                ffmpeg_params=self.encoding.ffmpeg_params,
+                frame_callback=stats.update,
+            )
+
+    def add_frame(self, frame: dict[str, Any]) -> None:
+        from lerobot.datasets.utils import validate_frame
+
+        validate_frame(frame, self.dataset.features)
+        buffer = self.dataset.episode_buffer
+        frame_index = buffer["size"]
+        buffer["frame_index"].append(frame_index)
+        buffer["timestamp"].append(frame_index / self.dataset.fps)
+        buffer["task"].append(frame["task"])
+        for key, value in frame.items():
+            if key == "task":
+                continue
+            if self.dataset.features[key]["dtype"] == "video":
+                self.writers[key].write(value)
+                buffer[key].append(str(self.paths[key]))
+            else:
+                buffer[key].append(value)
+        buffer["size"] += 1
+
+    def close(self) -> None:
+        errors = []
+        for writer in self.writers.values():
+            try:
+                writer.release()
+            except Exception as exc:
+                errors.append(exc)
+        self.writers.clear()
+        if errors:
+            raise RuntimeError(f"Failed to close {len(errors)} trajectory video writer(s)") from errors[0]
+
+    def discard(self) -> None:
+        self.close()
+        for path in self.paths.values():
+            shutil.rmtree(path.parent, ignore_errors=True)
+        self.paths.clear()
+        self.image_stats.clear()
+
+    def save(self) -> None:
+        from lerobot.datasets.compute_stats import compute_episode_stats
+        from lerobot.datasets.utils import validate_episode_buffer
+
+        if self.writers:
+            raise RuntimeError("Close episode video streams before saving")
+        dataset = self.dataset
+        episode_buffer = dataset.episode_buffer
+        validate_episode_buffer(episode_buffer, dataset.meta.total_episodes, dataset.features)
+        episode_length = episode_buffer.pop("size")
+        tasks = episode_buffer.pop("task")
+        episode_tasks = list(set(tasks))
+        episode_index = episode_buffer["episode_index"]
+        episode_buffer["index"] = np.arange(
+            dataset.meta.total_frames, dataset.meta.total_frames + episode_length
+        )
+        episode_buffer["episode_index"] = np.full((episode_length,), episode_index)
+        dataset.meta.save_episode_tasks(episode_tasks)
+        episode_buffer["task_index"] = np.array(
+            [dataset.meta.get_task_index(task) for task in tasks]
+        )
+        for key, feature in dataset.features.items():
+            if key in {"index", "episode_index", "task_index"} or feature["dtype"] == "video":
+                continue
+            episode_buffer[key] = np.stack(episode_buffer[key])
+
+        stats_features = {
+            key: feature for key, feature in dataset.features.items() if feature["dtype"] != "video"
+        }
+        episode_stats = compute_episode_stats(
+            {key: episode_buffer[key] for key in stats_features}, stats_features
+        )
+        episode_stats.update({key: stats.result() for key, stats in self.image_stats.items()})
+        episode_metadata = dataset._save_episode_data(episode_buffer)
+        for video_key in dataset.meta.video_keys:
+            episode_metadata.update(
+                dataset._save_episode_video(
+                    video_key,
+                    episode_index,
+                    temp_path=self.paths[video_key],
+                )
+            )
+        dataset.meta.save_episode(
+            episode_index,
+            episode_length,
+            episode_tasks,
+            episode_stats,
+            episode_metadata,
+        )
+        dataset.clear_episode_buffer(delete_images=False)
+        self.paths.clear()
+        self.image_stats.clear()
