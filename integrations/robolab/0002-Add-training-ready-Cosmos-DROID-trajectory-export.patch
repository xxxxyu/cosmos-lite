@@ -0,0 +1,26 @@
+# Training-ready Cosmos-DROID joint-position preset. Its 640x360, 15 FPS,
+# three-camera schema is fixed for compatibility with the current Cosmos
+# loader. Custom recorders can use robolab.core.logging.lerobot_trajectory.
+# output_root defaults to
+# <evaluation output>/droid_plus_lerobot_640x360_20260412 when null. Keeping
+# that basename lets Cosmos' DROID loader recognize the dataset directly.
+output_root: null
+repo_id: local/robolab-droid-joint-position
+# Set this to the exact Hugging Face model ID or local checkpoint digest used.
+checkpoint: XXXXyu/Cosmos3-Edge-Policy-DROID-GenW8A8
+fps: 15
+image_width: 640
+image_height: 360
+codec: h264
+crf: 23
+preset: ultrafast
+encoder_threads_per_camera: 1
+# Four frames per camera is enough to hide encoder jitter without adding the
+# roughly 450 MiB host-memory cost measured with a 16-frame queue at 10 envs.
+encoder_queue_frames: 4
+# Statistics sample every fourth frame; all video frames are still saved.
+image_stats_frame_stride: 4
+sidecar_level: full
+keep_failure_sidecars: true
+keep_staging: false
+overwrite: false
