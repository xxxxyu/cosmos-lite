diff --git a/robolab/core/logging/droid_lerobot_trajectory.py b/robolab/core/logging/droid_lerobot_trajectory.py
new file mode 100644
index 0000000..ba66e2a
--- /dev/null
+++ b/robolab/core/logging/droid_lerobot_trajectory.py
@@ -0,0 +1,534 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Success-only DROID joint-position trajectory recording in LeRobot v3 format."""
+
+from __future__ import annotations
+
+import json
+import logging
+import shutil
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+import yaml
+from scipy.spatial.transform import Rotation
+
+from robolab.core.logging.lerobot_trajectory import (
+    LeRobotVideoEpisode,
+    VideoEncodingConfig,
+    VideoStreamConfig,
+    resize_rgb_batch,
+    resize_rgb_streams,
+    video_features,
+)
+
+logger = logging.getLogger(__name__)
+
+FPS = 15
+IMAGE_HEIGHT = 360
+IMAGE_WIDTH = 640
+COSMOS_DROID_DATASET_VERSION = "droid_plus_lerobot_640x360_20260412"
+
+IMAGE_FEATURES = {
+    "observation.image.exterior_image_1_left": "over_shoulder_left_camera",
+    "observation.image.exterior_image_2_left": "over_shoulder_right_camera",
+    "observation.image.wrist_image_left": "wrist_cam",
+}
+DROID_VIDEO_STREAMS = tuple(
+    VideoStreamConfig(feature, camera, IMAGE_WIDTH, IMAGE_HEIGHT)
+    for feature, camera in IMAGE_FEATURES.items()
+)
+
+
+def droid_features() -> dict[str, dict[str, Any]]:
+    """Feature schema consumed by Cosmos' 640x360 DROID LeRobot loader."""
+    return {
+        **video_features(DROID_VIDEO_STREAMS),
+        "observation.state.joint_positions": {
+            "dtype": "float32",
+            "shape": (7,),
+            "names": [f"joint_{i}" for i in range(7)],
+        },
+        "observation.state.gripper_position": {
+            "dtype": "float32",
+            "shape": (1,),
+            "names": ["gripper"],
+        },
+        "observation.state.cartesian_position": {
+            "dtype": "float32",
+            "shape": (6,),
+            "names": ["x", "y", "z", "roll", "pitch", "yaw"],
+        },
+        "action.joint_position": {
+            "dtype": "float32",
+            "shape": (7,),
+            "names": [f"joint_{i}" for i in range(7)],
+        },
+        "action.gripper_position": {
+            "dtype": "float32",
+            "shape": (1,),
+            "names": ["gripper"],
+        },
+    }
+
+
+@dataclass(frozen=True)
+class DroidTrajectoryConfig:
+    output_root: str | None = None
+    repo_id: str = "local/robolab-droid-joint-position"
+    checkpoint: str = "unknown"
+    fps: int = FPS
+    image_width: int = IMAGE_WIDTH
+    image_height: int = IMAGE_HEIGHT
+    codec: str = "h264"
+    crf: int = 23
+    preset: str = "ultrafast"
+    encoder_threads_per_camera: int = 1
+    encoder_queue_frames: int = 4
+    image_stats_frame_stride: int = 4
+    sidecar_level: str = "full"
+    keep_failure_sidecars: bool = True
+    keep_staging: bool = False
+    overwrite: bool = False
+
+    @classmethod
+    def from_yaml(cls, path: str | Path) -> "DroidTrajectoryConfig":
+        with Path(path).open() as stream:
+            raw = yaml.safe_load(stream) or {}
+        unknown = set(raw) - set(cls.__dataclass_fields__)
+        if unknown:
+            raise ValueError(f"Unknown trajectory config keys: {sorted(unknown)}")
+        cfg = cls(**raw)
+        cfg.validate()
+        return cfg
+
+    def validate(self) -> None:
+        if self.checkpoint in {"", "unknown", "replace-with-model-id-or-checkpoint-digest"}:
+            raise ValueError("checkpoint must identify the policy weights used for rollout")
+        if self.fps != FPS:
+            raise ValueError(f"Cosmos DROID trajectories require fps={FPS}, got {self.fps}")
+        if (self.image_width, self.image_height) != (IMAGE_WIDTH, IMAGE_HEIGHT):
+            raise ValueError(
+                "Cosmos DROID trajectories require 640x360 RGB, got "
+                f"{self.image_width}x{self.image_height}"
+            )
+        if self.codec != "h264":
+            raise ValueError("Cosmos DROID trajectory recording currently supports codec='h264' only")
+        if self.encoder_queue_frames < 1:
+            raise ValueError("encoder_queue_frames must be positive")
+        if self.image_stats_frame_stride < 1:
+            raise ValueError("image_stats_frame_stride must be positive")
+        if self.sidecar_level not in {"minimal", "full"}:
+            raise ValueError("sidecar_level must be 'minimal' or 'full'")
+
+    def video_encoding(self) -> VideoEncodingConfig:
+        """Build the generic encoder config used by the DROID preset."""
+        return VideoEncodingConfig(
+            fps=self.fps,
+            codec=self.codec,
+            crf=self.crf,
+            preset=self.preset,
+            threads_per_stream=self.encoder_threads_per_camera,
+            queue_frames=self.encoder_queue_frames,
+            image_stats_frame_stride=self.image_stats_frame_stride,
+        )
+
+
+def _resize_rgb_batch(images: torch.Tensor, env_ids: list[int]) -> np.ndarray:
+    """Resize an RGB batch to the Cosmos-DROID training resolution."""
+    return resize_rgb_batch(images, env_ids, width=IMAGE_WIDTH, height=IMAGE_HEIGHT)
+
+
+def _resize_rgb_streams(image_obs: dict[str, torch.Tensor], env_ids: list[int]) -> dict[str, np.ndarray]:
+    """Resize all Cosmos-DROID streams using the generic batched path."""
+    return resize_rgb_streams(image_obs, env_ids, DROID_VIDEO_STREAMS)
+
+
+def _official_droid_gripper(robolab_value: np.ndarray | float) -> np.ndarray:
+    """Convert RoboLab (0=open, 1=closed) to raw DROID (1=open, 0=closed)."""
+    value = np.asarray(robolab_value, dtype=np.float32).reshape(1)
+    return 1.0 - np.clip(value, 0.0, 1.0)
+
+
+def _cartesian_position(position: np.ndarray, quat_wxyz: np.ndarray) -> np.ndarray:
+    quat_xyzw = np.asarray(quat_wxyz, dtype=np.float32)[[1, 2, 3, 0]]
+    euler_xyz = Rotation.from_quat(quat_xyzw).as_euler("xyz").astype(np.float32)
+    return np.concatenate((np.asarray(position, dtype=np.float32), euler_xyz)).astype(np.float32)
+
+
+def build_droid_frame(
+    *,
+    images: dict[str, np.ndarray],
+    joint_positions: np.ndarray,
+    gripper_position: np.ndarray,
+    ee_position: np.ndarray,
+    ee_quaternion_wxyz: np.ndarray,
+    executed_action: np.ndarray,
+    task: str,
+) -> dict[str, Any]:
+    """Build one aligned ``observation[t] -> executed_action[t]`` training row."""
+    action = np.asarray(executed_action, dtype=np.float32)
+    if action.shape != (8,):
+        raise ValueError(f"Expected 8D joint-position action, got {action.shape}")
+    return {
+        **images,
+        "observation.state.joint_positions": np.asarray(joint_positions, dtype=np.float32),
+        "observation.state.gripper_position": _official_droid_gripper(gripper_position),
+        "observation.state.cartesian_position": _cartesian_position(ee_position, ee_quaternion_wxyz),
+        "action.joint_position": action[:7],
+        "action.gripper_position": _official_droid_gripper(float(action[7] > 0.5)),
+        "task": task,
+    }
+
+
+def _jsonable(value: Any) -> Any:
+    if isinstance(value, torch.Tensor):
+        return value.detach().cpu().tolist()
+    if isinstance(value, np.ndarray):
+        return value.tolist()
+    if isinstance(value, np.generic):
+        return value.item()
+    if isinstance(value, dict):
+        return {str(key): _jsonable(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_jsonable(item) for item in value]
+    if isinstance(value, (str, int, float, bool)) or value is None:
+        return value
+    return str(value)
+
+
+def _slice_env(value: Any, env_id: int, num_envs: int) -> Any:
+    if isinstance(value, torch.Tensor) and value.ndim > 0 and value.shape[0] == num_envs:
+        return value[env_id]
+    if isinstance(value, np.ndarray) and value.ndim > 0 and value.shape[0] == num_envs:
+        return value[env_id]
+    if isinstance(value, dict):
+        return {key: _slice_env(item, env_id, num_envs) for key, item in value.items()}
+    return value
+
+
+@dataclass
+class _Slot:
+    env_id: int
+    dataset: Any
+    source_root: Path
+    successful_episodes: list[dict[str, Any]] = field(default_factory=list)
+    initial_state: dict[str, Any] | None = None
+    camera_extrinsics: dict[str, Any] | None = None
+    frame_count: int = 0
+    recording_s: float = 0.0
+    run_context: dict[str, Any] = field(default_factory=dict)
+    video_episode: LeRobotVideoEpisode | None = None
+
+
+class DroidLeRobotTrajectoryRecorder:
+    """Collect parallel RoboLab episodes and publish successes as one v3 dataset."""
+
+    def __init__(self, config: DroidTrajectoryConfig, experiment_output: str | Path):
+        config.validate()
+        self.config = config
+        self.output_root = Path(
+            config.output_root or Path(experiment_output) / COSMOS_DROID_DATASET_VERSION
+        )
+        self.success_root = self.output_root / "success"
+        self.staging_root = self.output_root / ".staging"
+        if self.output_root.exists():
+            if not config.overwrite:
+                raise FileExistsError(f"Trajectory output already exists: {self.output_root}")
+            shutil.rmtree(self.output_root)
+        self.staging_root.mkdir(parents=True)
+        self._slots: dict[int, _Slot] = {}
+        self._batch_active = False
+        self._recording_s = 0.0
+        self._commit_s = 0.0
+        self._env_config_paths: dict[str, str] = {}
+
+    def _new_slot(self, env_id: int) -> _Slot:
+        from lerobot.datasets.lerobot_dataset import LeRobotDataset
+
+        source_root = self.staging_root / f"env-{env_id:03d}"
+        dataset = LeRobotDataset.create(
+            repo_id=f"{self.config.repo_id}-env-{env_id:03d}",
+            root=source_root,
+            fps=self.config.fps,
+            robot_type="droid",
+            features=droid_features(),
+            use_videos=True,
+            vcodec=self.config.codec,
+        )
+        dataset.meta.update_chunk_settings(video_files_size_in_mb=1)
+        return _Slot(env_id=env_id, dataset=dataset, source_root=source_root)
+
+    def _start_streams(self, slot: _Slot) -> None:
+        slot.video_episode = LeRobotVideoEpisode(
+            dataset=slot.dataset,
+            source_root=slot.source_root,
+            streams=DROID_VIDEO_STREAMS,
+            encoding=self.config.video_encoding(),
+        )
+        slot.video_episode.start()
+
+    @staticmethod
+    def _close_streams(slot: _Slot) -> None:
+        if slot.video_episode is not None:
+            slot.video_episode.close()
+
+    @staticmethod
+    def _discard_streams(slot: _Slot) -> None:
+        if slot.video_episode is not None:
+            slot.video_episode.discard()
+            slot.video_episode = None
+
+    @staticmethod
+    def _add_streamed_frame(slot: _Slot, frame: dict[str, Any]) -> None:
+        if slot.video_episode is None:
+            raise RuntimeError("Episode video streams are not active")
+        slot.video_episode.add_frame(frame)
+
+    @staticmethod
+    def _save_streamed_episode(slot: _Slot) -> None:
+        if slot.video_episode is None:
+            raise RuntimeError("Episode video streams are not active")
+        slot.video_episode.save()
+        slot.video_episode = None
+
+    def begin_batch(self, env, env_cfg, *, task_name: str, run_index: int, policy: str) -> None:
+        if self._batch_active:
+            raise RuntimeError("A trajectory batch is already active")
+        self._batch_active = True
+        env_cfg_dir = self.output_root / "sidecars" / "env_configs"
+        env_cfg_dir.mkdir(parents=True, exist_ok=True)
+        env_cfg_path = env_cfg_dir / f"{task_name}.json"
+        if not env_cfg_path.exists():
+            env_cfg_path.write_text(json.dumps(_jsonable(env_cfg.to_dict()), indent=2) + "\n")
+        self._env_config_paths[task_name] = str(env_cfg_path.relative_to(self.output_root))
+
+        scene_state = env.scene.get_state(is_relative=True)
+        camera_extrinsics = self._camera_extrinsics(env)
+        for env_id in range(env.num_envs):
+            if env_id not in self._slots:
+                self._slots[env_id] = self._new_slot(env_id)
+            slot = self._slots[env_id]
+            if slot.frame_count:
+                raise RuntimeError(f"env {env_id} has an unfinished trajectory")
+            slot.initial_state = _jsonable(_slice_env(scene_state, env_id, env.num_envs))
+            slot.camera_extrinsics = _jsonable(_slice_env(camera_extrinsics, env_id, env.num_envs))
+            slot.run_context = {
+                "task": task_name,
+                "language_instruction": env_cfg.instruction,
+                "run_index": run_index,
+                "env_id": env_id,
+                "policy": policy,
+                "checkpoint": self.config.checkpoint,
+                "seed": int(env_cfg.seed) if env_cfg.seed is not None else None,
+                "env_config": self._env_config_paths[task_name],
+                "robolab_hdf5": str(Path(env.output_dir) / f"run_{run_index}.hdf5"),
+            }
+
+    @staticmethod
+    def _camera_extrinsics(env) -> dict[str, dict[str, torch.Tensor]]:
+        result = {}
+        origins = env.scene.env_origins[:, :3]
+        for camera_name in IMAGE_FEATURES.values():
+            camera = env.scene.sensors[camera_name]
+            result[camera_name] = {
+                "position_env": camera.data.pos_w - origins,
+                "quaternion_xyzw_ros": camera.data.quat_w_ros,
+            }
+        return result
+
+    def record_step(self, obs: dict, actions: torch.Tensor, active_env_ids: list[int]) -> None:
+        if not active_env_ids:
+            return
+        started = time.perf_counter()
+        image_batches = _resize_rgb_streams(obs["image_obs"], active_env_ids)
+        proprio = obs["proprio_obs"]
+        joint = proprio["arm_joint_pos"][active_env_ids].detach().cpu().numpy()
+        gripper = proprio["gripper_pos"][active_env_ids].detach().cpu().numpy()
+        ee_position = proprio["ee_pos"][active_env_ids].detach().cpu().numpy()
+        ee_quaternion = proprio["ee_quat"][active_env_ids].detach().cpu().numpy()
+        executed = actions[active_env_ids].detach().cpu().numpy()
+        shared_s = (time.perf_counter() - started) / len(active_env_ids)
+
+        for row, env_id in enumerate(active_env_ids):
+            env_started = time.perf_counter()
+            slot = self._slots[env_id]
+            if slot.video_episode is None:
+                self._start_streams(slot)
+            frame = build_droid_frame(
+                images={feature: batch[row] for feature, batch in image_batches.items()},
+                joint_positions=joint[row],
+                gripper_position=gripper[row],
+                ee_position=ee_position[row],
+                ee_quaternion_wxyz=ee_quaternion[row],
+                executed_action=executed[row],
+                task=slot.run_context["language_instruction"],
+            )
+            self._add_streamed_frame(slot, frame)
+            slot.frame_count += 1
+            slot.recording_s += shared_s + time.perf_counter() - env_started
+        self._recording_s += time.perf_counter() - started
+
+    def end_batch(self, env_results: list[dict], timing: dict, final_infos: list[dict] | None = None) -> None:
+        if not self._batch_active:
+            raise RuntimeError("No active trajectory batch")
+        result_by_env = {item["env_id"]: item for item in env_results}
+        final_infos = final_infos or []
+        for env_id, slot in self._slots.items():
+            result = result_by_env[env_id]
+            success = bool(result.get("success"))
+            final_info = final_infos[env_id] if env_id < len(final_infos) else {}
+            reason = (final_info or {}).get("info")
+            metadata = {
+                **slot.run_context,
+                "success": success,
+                "episode_length": slot.frame_count,
+                "termination_reason": "success" if success else reason or "time_limit_or_failure",
+                "rollout_timing": timing,
+                "recording_timing": {
+                    "record_step_attributed_s": round(slot.recording_s, 6),
+                },
+                "initial_state": slot.initial_state,
+                "camera_extrinsics": slot.camera_extrinsics,
+            }
+            if success:
+                commit_started = time.perf_counter()
+                self._close_streams(slot)
+                self._save_streamed_episode(slot)
+                episode_commit_s = time.perf_counter() - commit_started
+                metadata["recording_timing"]["lerobot_commit_s"] = round(episode_commit_s, 6)
+                local_episode = slot.dataset.meta.total_episodes - 1
+                sidecar_rel = self._write_sidecar(slot, metadata, local_episode, success=True)
+                slot.successful_episodes.append({**metadata, "sidecar_path": sidecar_rel})
+                self._commit_s += episode_commit_s
+            else:
+                self._discard_streams(slot)
+                slot.dataset.clear_episode_buffer(delete_images=False)
+                if self.config.keep_failure_sidecars:
+                    self._write_sidecar(slot, metadata, slot.run_context["run_index"], success=False)
+            slot.frame_count = 0
+            slot.recording_s = 0.0
+            slot.initial_state = None
+            slot.camera_extrinsics = None
+            slot.run_context = {}
+        self._batch_active = False
+
+    def abort_batch(self) -> None:
+        """Discard an interrupted batch without publishing partial episodes."""
+        for slot in self._slots.values():
+            self._discard_streams(slot)
+            slot.dataset.clear_episode_buffer(delete_images=False)
+            slot.frame_count = 0
+            slot.recording_s = 0.0
+            slot.initial_state = None
+            slot.camera_extrinsics = None
+            slot.run_context = {}
+        self._batch_active = False
+
+    def _write_sidecar(self, slot: _Slot, metadata: dict, index: int, *, success: bool) -> str:
+        category = "success" if success else "failure"
+        directory = self.output_root / "sidecars" / category / f"env-{slot.env_id:03d}"
+        directory.mkdir(parents=True, exist_ok=True)
+        stem = f"episode-{index:06d}"
+        if self.config.sidecar_level == "full":
+            source_path = Path(metadata["robolab_hdf5"])
+            if not source_path.exists() and success:
+                raise FileNotFoundError(f"RoboLab sidecar source is missing: {source_path}")
+            import h5py
+
+            source_key = f"data/demo_{slot.env_id}"
+            source_has_episode = False
+            if source_path.exists():
+                with h5py.File(source_path, "r") as source:
+                    source_has_episode = source_key in source
+                    if source_has_episode:
+                        hdf5_path = directory / f"{stem}.hdf5"
+                        with h5py.File(hdf5_path, "w") as target:
+                            data_group = target.create_group("data")
+                            source.copy(source_key, data_group, name="demo_0")
+                            data_group.attrs["source_env_id"] = slot.env_id
+                        metadata["trajectory_sidecar"] = str(hdf5_path.relative_to(self.output_root))
+            if not source_has_episode:
+                if success:
+                    raise RuntimeError(f"RoboLab sidecar source has no {source_key}: {source_path}")
+                metadata["trajectory_sidecar_unavailable"] = "episode_not_exported"
+        metadata.pop("robolab_hdf5", None)
+        json_path = directory / f"{stem}.json"
+        json_path.write_text(json.dumps(_jsonable(metadata), indent=2) + "\n")
+        return str(json_path.relative_to(self.output_root))
+
+    def finalize(self) -> Path | None:
+        if self._batch_active:
+            raise RuntimeError("Cannot finalize with an active trajectory batch")
+        sources = []
+        records = []
+        for env_id in sorted(self._slots):
+            slot = self._slots[env_id]
+            slot.dataset.finalize()
+            if slot.successful_episodes:
+                sources.append(slot)
+                records.extend(slot.successful_episodes)
+        if not sources:
+            logger.warning("No successful episodes were recorded; no success dataset was created")
+            return None
+
+        for episode_index, record in enumerate(records):
+            record["episode_index"] = episode_index
+            sidecar_path = self.output_root / record["sidecar_path"]
+            sidecar = json.loads(sidecar_path.read_text())
+            sidecar["episode_index"] = episode_index
+            sidecar_path.write_text(json.dumps(sidecar, indent=2) + "\n")
+
+        from lerobot.datasets.aggregate import aggregate_datasets
+
+        aggregate_datasets(
+            repo_ids=[slot.dataset.repo_id for slot in sources],
+            roots=[slot.source_root for slot in sources],
+            aggr_repo_id=self.config.repo_id,
+            aggr_root=self.success_root,
+            video_files_size_in_mb=1,
+        )
+        self._attach_episode_metadata(records)
+        manifest = {
+            "schema": "cosmos-droid-joint-position-lerobot-v3",
+            "repo_id": self.config.repo_id,
+            "successful_episodes": len(records),
+            "failed_episodes": sum(
+                len(list(path.glob("*.json")))
+                for path in (self.output_root / "sidecars" / "failure").glob("env-*")
+            ) if (self.output_root / "sidecars" / "failure").exists() else 0,
+            "recording_pre_step_s": round(self._recording_s, 6),
+            "episode_commit_s": round(self._commit_s, 6),
+            "config": _jsonable(self.config.__dict__),
+        }
+        (self.output_root / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+        if not self.config.keep_staging:
+            shutil.rmtree(self.staging_root)
+        return self.success_root
+
+    def _attach_episode_metadata(self, records: list[dict[str, Any]]) -> None:
+        import pandas as pd
+
+        episode_files = sorted((self.success_root / "meta" / "episodes").glob("chunk-*/file-*.parquet"))
+        offset = 0
+        for path in episode_files:
+            frame = pd.read_parquet(path)
+            subset = records[offset : offset + len(frame)]
+            if len(subset) != len(frame):
+                raise RuntimeError("LeRobot aggregate episode order does not match recorder metadata")
+            frame["success"] = True
+            frame["seed"] = [item["seed"] for item in subset]
+            frame["run_index"] = [item["run_index"] for item in subset]
+            frame["env_id"] = [item["env_id"] for item in subset]
+            frame["termination_reason"] = [item["termination_reason"] for item in subset]
+            frame["checkpoint"] = [item["checkpoint"] for item in subset]
+            frame["sidecar_path"] = [item["sidecar_path"] for item in subset]
+            frame.to_parquet(path, index=False)
+            offset += len(frame)
+        if offset != len(records):
+            raise RuntimeError(f"Expected {len(records)} episode rows, found {offset}")
