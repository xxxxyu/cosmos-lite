+def _to_recording_device(value):
+    """Recursively give long-lived recorder tensors CPU ownership.
+
+    Simulator observations are live CUDA buffers. Keeping clones of them in
+    ``EpisodeData`` makes VRAM grow with the episode horizon. A synchronous CPU
+    copy is intentional here: it is the correctness baseline and provides
+    natural backpressure before data enters the bounded HDF5 buffer.
+    """
+    if isinstance(value, dict):
+        return {key: _to_recording_device(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [_to_recording_device(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(_to_recording_device(item) for item in value)
+    if isinstance(value, torch.Tensor):
+        return value.detach().to(device="cpu")
+    return value
+
