+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+
+import h5py
+import torch
+from isaaclab.managers.recorder_manager import DatasetExportMode
+from isaaclab.utils.datasets import EpisodeData
+
+from robolab.core.logging.recorder_manager import (
+    RobolabRecorderManager,
+    _ChunkedEpisodeData,
+    _to_recording_device,
+)
+from robolab.core.logging.streaming_hdf5_handler import StreamingHDF5DatasetFileHandler
+
+
+def _assert_cpu_tree(value):
+    if isinstance(value, dict):
+        for item in value.values():
+            _assert_cpu_tree(item)
+    elif isinstance(value, torch.Tensor):
+        assert value.device.type == "cpu"
+
+
+def test_to_recording_device_detaches_nested_tensors():
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    source = torch.arange(12, device=device, dtype=torch.float32).reshape(1, 3, 4).requires_grad_()
+    converted = _to_recording_device(
+        {"rgb": source, "nested": {"state": source + 1}, "sequence": [source + 2]}
+    )
+
+    _assert_cpu_tree(converted)
+    assert not converted["rgb"].requires_grad
+    assert converted["sequence"][0].device.type == "cpu"
+    torch.testing.assert_close(converted["rgb"], source.detach().cpu())
+
+
+def test_manager_buffer_never_owns_cuda_tensors():
+    manager = object.__new__(RobolabRecorderManager)
+    manager._term_names = ["record_policy_observations"]
+    manager._episodes = {0: EpisodeData()}
+    manager._env = SimpleNamespace(num_envs=1)
+    manager._record_on_cpu = True
+
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    observation = {
+        "camera": torch.zeros((1, 8, 12, 3), dtype=torch.uint8, device=device),
+        "proprio": torch.ones((1, 7), device=device),
+    }
+    manager.add_to_episodes("obs", observation)
+
+    _assert_cpu_tree(manager._episodes[0].data)
+    assert manager._episodes[0].data["obs"]["camera"].shape == (1, 8, 12, 3)
+
+
+def test_implicit_streaming_indices_keep_parallel_envs_separate(tmp_path):
+    handler = StreamingHDF5DatasetFileHandler()
+    handler.create(str(tmp_path / "parallel.hdf5"))
+
+    manager = object.__new__(RobolabRecorderManager)
+    manager._term_names = ["record_policy_observations"]
+    manager._episodes = {env_id: EpisodeData() for env_id in range(3)}
+    manager._current_episode_index = {env_id: None for env_id in range(3)}
+    manager._streaming_active = {env_id: False for env_id in range(3)}
+    manager._terms = {}
+    manager._dataset_file_handler = handler
+    manager._failed_episode_dataset_file_handler = None
+    manager._hdf5_initialized = True
+    manager._env = SimpleNamespace(num_envs=3)
+    manager._record_on_cpu = True
+    manager.cfg = SimpleNamespace(dataset_export_mode=DatasetExportMode.EXPORT_ALL)
+    manager._exported_successful_episode_count = {}
+    manager._exported_failed_episode_count = {}
+    manager._step_count = {env_id: 0 for env_id in range(3)}
+
+    for step in range(5):
+        manager.add_to_episodes(
+            "actions",
+            torch.tensor([[step, env_id] for env_id in range(3)], dtype=torch.float32),
+        )
+    manager.flush_buffer(verbose=False)
+
+    for step in range(5, 8):
+        manager.add_to_episodes(
+            "actions",
+            torch.tensor([[step, env_id] for env_id in range(3)], dtype=torch.float32),
+        )
+    manager.flush_buffer(verbose=False)
+    manager.export_episodes()
+    handler.close()
+
+    with h5py.File(tmp_path / "parallel.hdf5", "r") as dataset:
+        assert sorted(dataset["data"].keys()) == ["demo_0", "demo_1", "demo_2"]
+        assert dataset["data"].attrs["total"] == 24
+        for env_id in range(3):
+            actions = dataset[f"data/demo_{env_id}/actions"][:]
+            assert actions.shape == (8, 2)
+            torch.testing.assert_close(
+                torch.from_numpy(actions[:, 1]),
+                torch.full((8,), env_id, dtype=torch.float32),
+            )
+
+
+def test_fast_handler_uses_uncompressed_frame_chunks(tmp_path):
+    handler = StreamingHDF5DatasetFileHandler(compression=None, image_chunk_frames=1)
+    handler.create(str(tmp_path / "fast.hdf5"))
+    episode = EpisodeData()
+    episode.add("obs/image_obs/camera", torch.zeros((8, 12, 3), dtype=torch.uint8))
+    handler.write_episode(episode)
+    handler.close()
+
+    with h5py.File(tmp_path / "fast.hdf5", "r") as dataset:
+        image = dataset["data/demo_0/obs/image_obs/camera"]
+        assert image.compression is None
+        assert image.chunks == (1, 8, 12, 3)
+
+
+def test_chunked_episode_materializes_each_leaf_once():
+    episode = _ChunkedEpisodeData()
+    source = torch.arange(24, dtype=torch.float32).reshape(3, 2, 4)
+    for step in source:
+        episode.add("obs/proprio", step)
+
+    assert not episode.is_empty()
+    assert len(episode._chunks["obs/proprio"]) == 3
+    materialized = episode.data
+    torch.testing.assert_close(materialized["obs"]["proprio"], source)
+    assert episode.data["obs"]["proprio"].data_ptr() == materialized["obs"]["proprio"].data_ptr()
+
+
+def test_chunked_episode_preserves_nontensor_leaves_for_export():
+    episode = _ChunkedEpisodeData()
+    episode.add("initial_state/object/root_pose", [0.0, 0.0, 0.0, 1.0])
+    assert episode.data["initial_state"]["object"]["root_pose"] == [[0.0, 0.0, 0.0, 1.0]]
