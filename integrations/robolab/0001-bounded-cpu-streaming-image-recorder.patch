+class _ChunkedEpisodeData(EpisodeData):
+    """Defer image-history concatenation until a bounded HDF5 flush."""
+
+    def __init__(self):
+        super().__init__()
+        self._chunks: dict[str, list] = {}
+        self._materialized = False
+
+    def add(self, key: str, value: torch.Tensor | dict):
+        if isinstance(value, dict):
+            for sub_key, sub_value in value.items():
+                self.add(f"{key}/{sub_key}", sub_value)
+            return
+        self._chunks.setdefault(key, []).append(value)
+        self._materialized = False
+
+    @property
+    def data(self):
+        if not self._materialized:
+            self._data = {}
+            for key, values in self._chunks.items():
+                pointer = self._data
+                parts = key.split("/")
+                for part in parts[:-1]:
+                    pointer = pointer.setdefault(part, {})
+                pointer[parts[-1]] = (
+                    torch.stack(values, dim=0)
+                    if all(isinstance(value, torch.Tensor) for value in values)
+                    else values
+                )
+            self._materialized = True
+        return self._data
+
+    @data.setter
+    def data(self, data: dict):
+        self._data = data
+        self._chunks = {}
+        self._materialized = True
+
+    def is_empty(self):
+        return not self._chunks and not self._data
+
+    def get_initial_state(self):
+        return self.data.get("initial_state")
+
 
