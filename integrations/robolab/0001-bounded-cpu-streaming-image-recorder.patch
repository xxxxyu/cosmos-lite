new file mode 100644
index 0000000..db6b0b6
--- /dev/null
+++ b/scripts/validate_recording.py
@@ -0,0 +1,72 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Validate the structural contract of a multi-env RoboLab HDF5 recording."""
+
+import argparse
+import json
+from pathlib import Path
+
+import h5py
+import numpy as np
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("recording", type=Path)
+    parser.add_argument("--expected-demos", type=int, required=True)
+    parser.add_argument("--expected-steps", type=int, required=True)
+    args = parser.parse_args()
+
+    errors = []
+    summary = {"recording": str(args.recording), "demos": {}}
+    with h5py.File(args.recording, "r") as dataset:
+        if "data" not in dataset:
+            raise SystemExit("missing /data group")
+        data = dataset["data"]
+        demos = sorted(data.keys(), key=lambda name: int(name.removeprefix("demo_")))
+        if len(demos) != args.expected_demos:
+            errors.append(f"expected {args.expected_demos} demos, found {len(demos)}")
+
+        summary["provenance"] = json.loads(data.attrs.get("env_args", "{}"))
+        for name in demos:
+            demo = data[name]
+            actions = demo.get("actions")
+            if actions is None or actions.shape[0] != args.expected_steps:
+                errors.append(f"{name}: actions steps={None if actions is None else actions.shape[0]}")
+
+            initial_state = demo.get("initial_state/articulation/robot/joint_position")
+            if initial_state is None or initial_state.shape[0] != 1:
+                errors.append(f"{name}: expected one robot initial state")
+
+            images = {}
+            image_group = demo.get("obs/image_obs")
+            if image_group is None:
+                errors.append(f"{name}: missing obs/image_obs")
+            else:
+                for camera, image in image_group.items():
+                    images[camera] = {"shape": list(image.shape), "dtype": str(image.dtype)}
+                    if image.shape[0] != args.expected_steps:
+                        errors.append(f"{name}/{camera}: image steps={image.shape[0]}")
+                    if image.dtype != np.uint8 or image.ndim != 4 or image.shape[-1] != 3:
+                        errors.append(f"{name}/{camera}: expected TxHxWx3 uint8, got {image.shape} {image.dtype}")
+
+            if demo.get("obs/viewport_cam") is not None:
+                errors.append(f"{name}: viewport-only observations were recorded")
+            summary["demos"][name] = {
+                "steps": None if actions is None else actions.shape[0],
+                "images": images,
+            }
+
+        expected_total = args.expected_demos * args.expected_steps
+        if int(data.attrs.get("total", -1)) != expected_total:
+            errors.append(f"expected total={expected_total}, found {data.attrs.get('total')}")
+
+    summary["valid"] = not errors
+    summary["errors"] = errors
+    print(json.dumps(summary, indent=2))
+    return 0 if not errors else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
